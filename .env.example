# NOTE: nothing loads a .env file — the app reads os.environ directly. The
# systemd user unit gets these via EnvironmentFile (see "Configuration and
# secrets" in CLAUDE.md); for a foreground run, source them into the shell.
#
# Every value here mirrors the default in settings.py. Set a variable only to
# deviate from that default; see AGENTS.md for what the service
# actually sets (OCTAVIUS_DB_PATH, the TTS variables, the lilripper key).

# --- Speech in -------------------------------------------------------------
OCTAVIUS_STT_URL=http://lilripper:8552/api/transcribe

# --- LLM chains ------------------------------------------------------------
# These mirror the code defaults in settings.py, which mirror the live
# ~/.config/octavius/models.json as of 2026-10-28 (models.json overrides the
# defaults; these variables override models.json). The model id is load-bearing
# on every endpoint: an alias absent from that endpoint's catalog hard-400s and
# silently burns a failover hop. Run scripts/octavius-models check after any
# router change.
#  - lilbuddy:8010 and triplestuffed:8010 are llama.cpp routers, open (no auth).
#  - lilripper:8020 is vLLM, BEHIND AUTH (see OCTAVIUS_LR_API_KEY below), and is
#    the fallback of every role. lilripper:8010 now serves only glm-5.3-flash and
#    Octavius does not use it.
#  - gemma4 is a thinking model: reasoning arrives in `reasoning_content`
#    (agent.py reads `content`), but budget for reasoning tokens if you ever set
#    max_tokens.
OCTAVIUS_LLM_CHAIN=[{"url":"http://lilbuddy:8010/v1/chat/completions","model":"gemma4-26b-a4b"},{"url":"http://lilripper:8020/v1/chat/completions","model":"qwen3.8-27b"},{"url":"http://triplestuffed:8010/v1/chat/completions","model":"gemma4-12b"}]

# Scoped specialist subagents (consult_specialist). "role" drives routing:
# primary = first try + concurrency tier, fallback = per-call HTTP failover (the
# dispatcher keeps only the FIRST fallback entry). "capacity" sits below the
# endpoint's --parallel (triplestuffed: 4). The model is chosen per ENDPOINT URL,
# not per domain (see subagent.py::_model_for_url).
OCTAVIUS_SUBAGENT_LLM_CHAIN=[{"url":"http://triplestuffed:8010/v1/chat/completions","model":"gemma4-12b","role":"primary","capacity":3},{"url":"http://lilripper:8020/v1/chat/completions","model":"qwen3.8-27b","role":"fallback","capacity":2}]

# Vision-capable chain used only for turns carrying image content. Kept separate
# from the main chain because that chain's third hop (triplestuffed gemma4-12b)
# is TEXT-ONLY. Check architecture.input_modalities and --ubatch-size in
# /v1/models before adding an entry here.
OCTAVIUS_VISION_LLM_CHAIN=[{"url":"http://lilbuddy:8010/v1/chat/completions","model":"gemma4-26b-a4b"},{"url":"http://lilripper:8020/v1/chat/completions","model":"qwen3.8-27b"}]

# End-of-conversation summary + topic tags. SummaryClient carries a model PER URL,
# so the fallback has its own. A failed summary is silent (history just ends up
# unsummarised/untagged), so verify changes here. Summaries fire at conversation
# END, so the open triplestuffed host is primary and the authed :8020 fallback.
OCTAVIUS_SUMMARY_URL=http://triplestuffed:8010/v1/chat/completions
OCTAVIUS_SUMMARY_MODEL=gemma4-12b
OCTAVIUS_SUMMARY_FALLBACK_URL=http://lilripper:8020/v1/chat/completions
OCTAVIUS_SUMMARY_FALLBACK_MODEL=qwen3.8-27b
OCTAVIUS_SUMMARY_TIMEOUT=60

# --- LLM endpoint auth -----------------------------------------------------
# Only the two lilripper ports (:8010, :8020) are behind auth; today Octavius
# uses :8020 only, as every role's fallback. A 401 surfaces as an ordinary chain
# failure (it burns a failover hop), so a missing or mangled key fails QUIETLY:
# the primaries are open, so it removes the safety net rather than the first hop.
# Check /health's endpoints_rejecting_credentials. Real values belong in
# ~/.config/secrets.env (the service sources it), never in the repo.
#
# Preferred: a dedicated var for the lilripper token (LR = lilripper). It is
# applied to BOTH lilripper router ports and takes precedence over the JSON map
# below. lilbuddy:8010 and triplestuffed:8010 are OPEN and never receive it.
OCTAVIUS_LR_API_KEY=sk-...
#
# General mechanism: bearer tokens keyed by ORIGIN (scheme://host:port),
# resolved for every chain that touches that origin. Use this if another
# endpoint ever goes behind auth.
OCTAVIUS_LLM_API_KEYS={"http://lilripper:8020":"sk-..."}

# --- Speech out ------------------------------------------------------------
# Phonon 31m on lilripper:8881 is the live TTS. Voxtral is WIRED BUT DISABLED
# (voxtral_enabled defaults to False): every synth call goes straight to the
# FALLBACK_* endpoint, and any voice not in OCTAVIUS_TTS_KOKORO_VOICES is
# remapped to FALLBACK_VOICE. Set OCTAVIUS_TTS_VOXTRAL_ENABLED=1 to restore the
# Voxtral-primary path — but confirm the URL below first, it is stale (Voxtral
# is not deployed on triplestuffed, and lilripper:8030 collides with
# OCTAVIUS_AGENT_PORT).
OCTAVIUS_TTS_VOXTRAL_ENABLED=0
OCTAVIUS_TTS_URL=http://lilripper:8030/v1/audio/speech
OCTAVIUS_TTS_MODEL=voxtral-4b-tts
OCTAVIUS_TTS_VOICE=Imogen
OCTAVIUS_TTS_FORMAT=wav
OCTAVIUS_TTS_FALLBACK_URL=http://lilripper:8881/v1/audio/speech
OCTAVIUS_TTS_FALLBACK_MODEL=phonon-31m-en
OCTAVIUS_TTS_FALLBACK_VOICE=Imogen
# Misnamed: "voices passed through unchanged to the fallback endpoint". List only
# names the server has (GET /v1/audio/voices); Phonon 400s on unknown voices,
# including every Kokoro name. Rollback to Kokoro: lilripper:8880, model
# "kokoro", voices like bm_lewis.
OCTAVIUS_TTS_KOKORO_VOICES=["Imogen","Delia","Hugh","Edwin","Spencer","Teddy","Sir Bramwell"]

# --- Embeddings ------------------------------------------------------------
# "schema" picks the request/response shape: openai (llama.cpp) or ollama.
# workhorse leads: lilbuddy went down 2026-08-10 and a dead primary costs the
# full connect timeout on every embed.
OCTAVIUS_EMBEDDING_CHAIN=[{"url":"http://lilbuddy:8020/v1/embeddings","model":"bge-m3","schema":"openai"},{"url":"http://workhorse:11434/api/embeddings","model":"bge-m3","schema":"ollama"}]
OCTAVIUS_EMBEDDING_TIMEOUT=5

# --- Memory service --------------------------------------------------------
# Loopback HTTP client of the shared memory brain. Empty => memory disabled.
OCTAVIUS_MEMORY_URL=http://127.0.0.1:8031
OCTAVIUS_MEMORY_READ_TIMEOUT=10
OCTAVIUS_MEMORY_WRITE_TIMEOUT=120

# --- App / storage ---------------------------------------------------------
OCTAVIUS_AGENT_PORT=8030
OCTAVIUS_DOWNLOADS_DIR=/home/dave/octavius-downloads
OCTAVIUS_READER_DIR=/home/dave/octavius-reader
OCTAVIUS_READER_LLM_URL=http://triplestuffed:8010/v1/chat/completions
# Same alias as the other triplestuffed consumers (subagent, summary, main hop 3)
# on purpose — otherwise the router thrashes between resident models.
OCTAVIUS_READER_LLM_MODEL=gemma4-12b
# Failover tried before the local strip_latex degradation (authed).
OCTAVIUS_READER_LLM_FALLBACK_URL=http://lilripper:8020/v1/chat/completions
OCTAVIUS_READER_LLM_FALLBACK_MODEL=qwen3.8-27b
# The service unit sets this to the ext4 NVMe; see the systemd drop-in.
OCTAVIUS_DB_PATH=/media/extra_stuff/octavius/octavius_history.db

# --- PDF -> markdown -------------------------------------------------------
# docproc is reached through the "document-processing" MCP server, NOT over
# loopback HTTP. There is no OCTAVIUS_DOCPROC_URL setting; only the poll knobs
# below are read (settings.py).
OCTAVIUS_DOCPROC_POLL_INTERVAL=3
OCTAVIUS_DOCPROC_POLL_TIMEOUT=300
OCTAVIUS_DOCPROC_INLINE_CHAR_BUDGET=20000
OCTAVIUS_DOCPROC_EXCERPT_CHARS=3000
