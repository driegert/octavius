# NOTE: nothing loads a .env file — the app reads os.environ directly. The
# systemd user unit gets these via EnvironmentFile (see "Configuration and
# secrets" in CLAUDE.md); for a foreground run, source them into the shell.
OCTAVIUS_STT_URL=http://127.0.0.1:8502/api/transcribe
OCTAVIUS_LLM_CHAIN=[{"url":"http://lilripper:8020/v1/chat/completions","model":"qwen3.6-35b-a3b"},{"url":"http://127.0.0.1:8001/v1/chat/completions","model":"qwen3.6-35b-a3b"},{"url":"http://triplestuffed:8010/v1/chat/completions","model":"qwen3.6-35b-a3b"}]
# Vision-capable chain used only for turns carrying image content (image_input
# WS frames from the Matrix sidecar). Needs an endpoint with image input
# enabled — most of OCTAVIUS_LLM_CHAIN's endpoints don't have it.
OCTAVIUS_VISION_LLM_CHAIN=[{"url":"http://lilripper:8010/v1/chat/completions","model":"qwen3.6-35b-a3b-general"}]
# Bearer tokens for LLM endpoints behind auth, keyed by origin
# (scheme://host:port). Endpoints not listed get no Authorization header.
# The real value belongs in ~/.config/octavius/env, never in the repo.
OCTAVIUS_LLM_API_KEYS={"http://lilripper:8010":"sk-..."}
OCTAVIUS_TTS_URL=http://triplestuffed:8020/v1/audio/speech
OCTAVIUS_TTS_MODEL=/media/extra_stuff/huggingface/mistralai/Voxtral-4B-TTS-2603
OCTAVIUS_TTS_VOICE=de_male
OCTAVIUS_TTS_FORMAT=wav
OCTAVIUS_TTS_FALLBACK_URL=http://lilbuddy:8880/v1/audio/speech
OCTAVIUS_TTS_FALLBACK_MODEL=kokoro
OCTAVIUS_TTS_FALLBACK_VOICE=bm_lewis
OCTAVIUS_AGENT_PORT=8030
OCTAVIUS_DOWNLOADS_DIR=/home/dave/octavius-downloads
OCTAVIUS_READER_DIR=/home/dave/octavius-reader
OCTAVIUS_READER_LLM_URL=http://lilripper:8010/v1/chat/completions
OCTAVIUS_READER_LLM_MODEL=qwen3.6-35b-a3b-general
# docproc web queue (PDF -> markdown), talked to over loopback HTTP only.
OCTAVIUS_DOCPROC_URL=http://127.0.0.1:8210
OCTAVIUS_DOCPROC_POLL_INTERVAL=3
OCTAVIUS_DOCPROC_POLL_TIMEOUT=300
OCTAVIUS_DOCPROC_INLINE_CHAR_BUDGET=20000
OCTAVIUS_DOCPROC_EXCERPT_CHARS=3000
