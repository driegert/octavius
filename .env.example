# NOTE: nothing loads a .env file — the app reads os.environ directly. The
# systemd user unit gets these via EnvironmentFile (see "Configuration and
# secrets" in CLAUDE.md); for a foreground run, source them into the shell.
#
# Every value here mirrors the default in settings.py. Set a variable only to
# deviate from that default; the service currently sets just OCTAVIUS_DB_PATH
# and OCTAVIUS_LLM_API_KEYS.

# --- Speech in -------------------------------------------------------------
OCTAVIUS_STT_URL=http://lilripper:8552/api/transcribe

# --- LLM chains ------------------------------------------------------------
# Both lilripper ports are llama.cpp ROUTERS, so the model id selects which
# model is served — it is not cosmetic, and naming an alias absent from that
# port's catalog hard-400s and burns a failover hop. Router aliases all carry a
# variant suffix; the bare "qwen3.6-35b-a3b" alias exists on NEITHER lilripper
# port. It is gone from lilbuddy:8010 too as of 2026-08-18 — a real completion
# there returns `400 model 'qwen3.6-35b-a3b' not found` — so the third hop now
# names gemma4-26b-a4b, which lilbuddy carries and serves quickly. Do NOT put a
# 35B here: loading qwen3.6-35b-a3b-mtp-q4-general took lilbuddy's whole router
# down until it restarted. gemma4 is a thinking model that returns reasoning in
# a separate `reasoning_content` field (harmless — agent.py reads `content`),
# but budget for reasoning tokens if you ever set max_tokens.
# ORDER CHANGED 2026-08-18: :8010 is the primary, :8020 the second hop. :8010
# is --parallel 3 and is already home to the subagent, vision, reader and
# summary paths on this SAME alias, so a turn, a consult and a document read
# now share one resident model with no swap. :8020 was demoted so Dave can keep
# other models loaded there by hand without every Octavius turn evicting them.
# :8010 is BEHIND AUTH, so a missing key now 401s the primary — check /health's
# endpoints_rejecting_credentials first if the chain looks flaky.
# triplestuffed:8010 was dropped on 2026-08-08 (Positron autocomplete/NES own
# its GPUs; it accepts connections and never generates, so failing into it
# burned the full 120 s read timeout).
OCTAVIUS_LLM_CHAIN=[{"url":"http://lilripper:8010/v1/chat/completions","model":"qwen3.6-35b-a3b-mtp-general"},{"url":"http://lilripper:8020/v1/chat/completions","model":"qwen3.6-35b-a3b-mtp-general"},{"url":"http://lilbuddy:8010/v1/chat/completions","model":"gemma4-26b-a4b"}]

# Scoped specialist subagents (consult_specialist). "role" drives routing:
# primary = first try + concurrency tier, fallback = per-call HTTP failover.
# "capacity" must match the endpoint's --parallel. NOTE: the model is chosen
# per ENDPOINT URL, not per domain — every specialist on a given URL shares one
# model (see subagent.py::_model_for_url). Both chain entries hit routers, so
# both model ids must exist in their endpoint's catalog.
OCTAVIUS_SUBAGENT_LLM_CHAIN=[{"url":"http://lilripper:8010/v1/chat/completions","model":"qwen3.6-35b-a3b-mtp-general","role":"primary","capacity":3},{"url":"http://lilripper:8020/v1/chat/completions","model":"qwen3.6-35b-a3b-mtp-general","role":"fallback"}]

# Vision-capable chain used only for turns carrying image content (image_input
# WS frames from the Matrix sidecar). Reordered :8010-first on 2026-08-18 with
# the main chain. Kept separate even though it now duplicates that chain's
# first two hops: OCTAVIUS_LLM_CHAIN has a THIRD hop on another host, picked
# for availability rather than modality. Separate chains are what stop a future
# "add a fallback so voice survives a lilripper outage" edit there from
# silently widening where an image turn can land. Check
# architecture.input_modalities in /v1/models before adding an entry here.
OCTAVIUS_VISION_LLM_CHAIN=[{"url":"http://lilripper:8010/v1/chat/completions","model":"qwen3.6-35b-a3b-mtp-general"},{"url":"http://lilripper:8020/v1/chat/completions","model":"qwen3.6-35b-a3b-mtp-general"}]

# End-of-conversation summary + topic tags. SummaryClient sends ONE model to
# both URLs, so the alias must exist on both ports. A failed summary is silent
# (history just ends up unsummarised/untagged), so verify changes here.
# Reordered :8010-first 2026-08-18: summaries fire at conversation END, long
# after Dave has moved on, so a :8020 primary meant a background job could
# quietly evict a model he had loaded there by hand.
OCTAVIUS_SUMMARY_URL=http://lilripper:8010/v1/chat/completions
OCTAVIUS_SUMMARY_FALLBACK_URL=http://lilripper:8020/v1/chat/completions
OCTAVIUS_SUMMARY_MODEL=qwen3.6-35b-a3b-mtp-general
OCTAVIUS_SUMMARY_TIMEOUT=60

# --- LLM endpoint auth -----------------------------------------------------
# Only lilripper:8010 is behind auth today. A 401 surfaces as an ordinary chain
# failure (it burns a failover hop), so a missing or mangled key fails QUIETLY
# rather than as an obvious auth error. Real values belong in
# ~/.config/octavius/env, never in the repo.
#
# Preferred: a dedicated var for the lilripper:8010 token. This is the one that
# rotates, so it takes precedence over the JSON map below. Named for the port,
# but bound to lilripper only — lilbuddy:8010 and triplestuffed:8010 also
# listen on 8010 and are OPEN; they never receive this header.
OCTAVIUS_8010_API_KEY=sk-...
#
# General mechanism: bearer tokens keyed by ORIGIN (scheme://host:port),
# resolved for every chain that touches that origin. Use this if another
# endpoint ever goes behind auth. Endpoints not listed get no Authorization
# header, which is why lilripper:8020 is deliberately absent.
OCTAVIUS_LLM_API_KEYS={"http://lilripper:8010":"sk-..."}

# --- Speech out ------------------------------------------------------------
# Voxtral is WIRED BUT DISABLED (voxtral_enabled defaults to False): every
# synth call goes straight to the Kokoro "fallback", and Voxtral-only voices
# are remapped to the fallback voice. Set OCTAVIUS_TTS_VOXTRAL_ENABLED=1 to
# restore the Voxtral-primary path — but confirm the URL below first, it is
# stale (Voxtral is not deployed on triplestuffed, and lilripper:8030 collides
# with OCTAVIUS_AGENT_PORT).
OCTAVIUS_TTS_VOXTRAL_ENABLED=0
OCTAVIUS_TTS_URL=http://lilripper:8030/v1/audio/speech
OCTAVIUS_TTS_MODEL=voxtral-4b-tts
OCTAVIUS_TTS_VOICE=bm_lewis
OCTAVIUS_TTS_FORMAT=wav
# Kokoro — the live TTS path.
OCTAVIUS_TTS_FALLBACK_URL=http://lilbuddy:8880/v1/audio/speech
OCTAVIUS_TTS_FALLBACK_MODEL=kokoro
OCTAVIUS_TTS_FALLBACK_VOICE=bm_lewis

# --- Embeddings ------------------------------------------------------------
# "schema" picks the request/response shape: openai (llama.cpp) or ollama.
# workhorse leads: lilbuddy went down 2026-08-10 and a dead primary costs the
# full connect timeout on every embed.
OCTAVIUS_EMBEDDING_CHAIN=[{"url":"http://lilbuddy:8020/v1/embeddings","model":"bge-m3","schema":"openai"},{"url":"http://workhorse:11434/api/embeddings","model":"bge-m3","schema":"ollama"}]
OCTAVIUS_EMBEDDING_TIMEOUT=5
# Background re-embed of rows whose inline embed failed. Off switch for a box
# whose embedder is dead.
OCTAVIUS_EMBEDDING_SWEEPER=1

# --- Memory service --------------------------------------------------------
# Loopback HTTP client of the shared memory brain. Empty => memory disabled.
OCTAVIUS_MEMORY_URL=http://127.0.0.1:8031
OCTAVIUS_MEMORY_READ_TIMEOUT=10
OCTAVIUS_MEMORY_WRITE_TIMEOUT=120

# --- App / storage ---------------------------------------------------------
OCTAVIUS_AGENT_PORT=8030
OCTAVIUS_DOWNLOADS_DIR=/home/dave/octavius-downloads
OCTAVIUS_READER_DIR=/home/dave/octavius-reader
OCTAVIUS_READER_LLM_URL=http://lilripper:8010/v1/chat/completions
# Same alias as the subagent chain's :8010 entry, on purpose — otherwise the
# router thrashes between two resident models when a document read and a
# specialist consult interleave.
OCTAVIUS_READER_LLM_MODEL=qwen3.6-35b-a3b-mtp-general
# The service unit sets this to the ext4 NVMe; see the systemd drop-in.
OCTAVIUS_DB_PATH=/media/extra_stuff/octavius/octavius_history.db

# --- PDF -> markdown -------------------------------------------------------
# docproc is reached through the "document-processing" MCP server, NOT over
# loopback HTTP. There is no OCTAVIUS_DOCPROC_URL setting; only the poll knobs
# below are read (settings.py).
OCTAVIUS_DOCPROC_POLL_INTERVAL=3
OCTAVIUS_DOCPROC_POLL_TIMEOUT=300
OCTAVIUS_DOCPROC_INLINE_CHAR_BUDGET=20000
OCTAVIUS_DOCPROC_EXCERPT_CHARS=3000
